<?xml version="1.0" encoding="UTF-8"?>
<package format="1">
    <name>FreeSolid</name>
    <description>A familiar mechanical-CAD interface for FreeCAD: a chronological feature tree with a rollback bar, SolidWorks-style command names, and a preference pack that puts navigation and panel layout where a designer coming from commercial parametric CAD expects them.</description>
    <version>0.3.1-alpha</version>
    <date>2026-08-02</date>
    <maintainer email="emilien@etadam.com">Emilien</maintainer>
    <license file="LICENSE">LGPL-2.1-or-later</license>
    <icon>resources/icons/freesolid.svg</icon>
    <url type="repository" branch="main">https://github.com/Emilien-Etadam/Freesolid</url>
    <url type="bugtracker">https://github.com/Emilien-Etadam/Freesolid/issues</url>
    <url type="readme">https://github.com/Emilien-Etadam/Freesolid/blob/main/README.md</url>
    <tag>UI</tag>
    <tag>PartDesign</tag>
    <tag>onboarding</tag>
    <tag>mechanical</tag>
    <content>
        <workbench>
            <classname>FreeSolidWorkbench</classname>
            <subdirectory>./</subdirectory>
        </workbench>
        <!-- FreeCAD resolves a preference pack from a directory named exactly
             like the pack, at the addon root; <subdirectory> is ignored here.
             Hence ./FreeSolid/FreeSolid.cfg, not ./preference_packs/. -->
        <preferencepack>
            <name>FreeSolid</name>
            <description>Navigation, disposition des panneaux et atelier de démarrage adaptés aux concepteurs venant de la CAO mécanique commerciale.</description>
            <tag>navigation</tag>
            <tag>layout</tag>
        </preferencepack>
    </content>
    <depend type="internal">FreeCAD</depend>
    <freecadmin>1.0</freecadmin>
    <pythonmin>3.10</pythonmin>
</package>
